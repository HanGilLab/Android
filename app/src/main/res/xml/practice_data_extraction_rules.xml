<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <!-- MapLibre stores its ambient tile database and sidecars under filesDir. -->
  <cloud-backup>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
  </device-transfer>
</data-extraction-rules>
